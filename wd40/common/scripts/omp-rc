#!/usr/bin/env bash
# wd40: omp-rc - $VISUAL wrapper for omp: open FILE in VS Code on the Mac via
# remote-code, without blocking omp's pane. Waits on /dev/tty until you press
# Enter.
set -euo pipefail

file=${1:?usage: omp-rc FILE}

# Open on the Mac (fire-and-forget). Mac host and remote host come from
# REMOTE_CODE_MAC_HOST / REMOTE_CODE_REMOTE_HOST.
remote-code "$file"

prompt="Edit in VS Code, save, then press Enter here to return to omp."

printf '%s\n' "$prompt"
read -r _ </dev/tty
