[core]
	excludesfile = ~/.gitignore
	editor = vim
	pager = hunk pager
	hooksPath = ~/.config/git/hooks

# Runs pre-commit in any repo with a .pre-commit-config.yaml, alongside the
# hooks in hooksPath (Git runs config hooks first, then the hooks directory),
# so `pre-commit install` is never needed. Repos without a config: no-op.
[hook "pre-commit-framework"]
	event = pre-commit
	command = pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --skip-on-missing-config --

[color]
	ui = auto
	diff = auto
	status = auto
	branch = auto
	interactive = auto

[pack]
	threads = 0

[diff]
	renamelimit = 0

[log]
	abbrevCommit = true
	decorate = short

[alias]
	br = branch
	co = checkout
	st = status
	dc = diff --cached
	fpa = fetch --prune --all
	cane = commit --amend --no-edit
	pf = push -f
	pr = pull --rebase
	nb = checkout -b

	ds = !git -c core.pager='hunk pager --mode stack' diff
	da = !git -c core.pager='hunk pager --mode auto' diff
	alias = !git config --global -l | grep 'alias.' | cut -d. -f2-
	codereview = log --decorate -p --reverse
    changelog = log --abbrev-commit --pretty=format:'%h %s'
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	changelog = log --graph --pretty=format:'%Cred%h%Creset %s' --abbrev-commit
	log-compact = log --abbrev-commit --decorate=no --pretty=format:"%h%x09%an%x09%ad%x09%s" --date=short
	log-diff = log --abbrev-commit --decorate -p
	log-changed = log --name-status
	lol = log --abbrev-commit --decorate --pretty=oneline --graph
	lol-all = log --abbrev-commit --decorate --pretty=oneline --graph --all
	ls = ls-files
	show-changed = show --pretty=\"format:\" --name-only
	unpushed = diff @{u}.. --name-status
	unpushed-all = log --graph --decorate --pretty=oneline --abbrev-commit --all @{upstream}^..

[push]
	default = current

[fetch]
	prune = true

[pull]
	rebase = merges

[credential "https://github.com"]
	helper =
	# GUI apps (Obsidian, VS Code) launch git with a minimal PATH that has no
	# Homebrew prefix, so a bare `gh` is "command not found" and git falls back to
	# prompting for a username. On Linux the extra dirs just don't match anything.
	helper = !/usr/bin/env PATH=/opt/homebrew/bin:/usr/local/bin:$PATH gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	# same wrapper as above; gh serves gist.github.com from the github.com token
	helper = !/usr/bin/env PATH=/opt/homebrew/bin:/usr/local/bin:$PATH gh auth git-credential
